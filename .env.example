# Example only. On Bothost enter these values in environment settings.
# main.py reads the environment, not .env files automatically.
BOT_TOKEN=PASTE_TOKEN_FROM_BOTFATHER
# Initial migration only. Sole admin 7011639945 adds employees using /staff.
ALLOWED_USER_IDS=7011639945
# sqlite or google_sheets; cloud errors never switch to local storage.
STORAGE_BACKEND=sqlite
# Existing SQLite is required by default. Set 1 only for explicit first creation,
# then return to 0. Never enable this to repair a missing production database.
ALLOW_NEW_DATABASE=0
# Bothost: persistent data directory, not the repository root.
DB_PATH=/app/data/guests.sqlite3
# Required only for google_sheets. Configure privately on the hosting platform.
SHEETS_ENDPOINT=
SHEETS_SECRET=
SHEETS_OWNER_EMAIL=
# Optional compatible SQLite databases for reports, in addition to the selected primary backend.
EXTRA_DB_PATHS=[]
